# Kroger developer credentials -> https://developer.kroger.com (free)
# Without these, Kroger-family stores fall back to seeded prices (badged as such).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Kroger cart push (optional). Must match a redirect URI registered on your
# Kroger developer app EXACTLY, including scheme, host, port and path.
KROGER_REDIRECT_URI=http://localhost:3000/api/kroger/callback
